{
  "name": "kh-fab",
  "productName": "KH Fab",
  "version": "1.0.2",
  "description": "Kh International — nesting ба bending програм",
  "author": "Kh International",
  "main": "main.js",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always",
    "build-app": "python3 src/build.py"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3",
    "jszip": "3.10.1",
    "jspdf": "2.5.1",
    "pdfjs-dist": "3.11.174",
    "opentype.js": "1.3.4",
    "clipper-lib": "6.4.2",
    "@fontsource/ibm-plex-sans": "5.0.20",
    "@fontsource/ibm-plex-mono": "5.0.13"
  },
  "build": {
    "appId": "mn.khinternational.fab",
    "productName": "KH Fab",
    "copyright": "Kh International",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KH Fab",
      "artifactName": "KH-Fab-Setup-${version}.${ext}",
      "installerLanguages": [
        "en_US"
      ],
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mrheakup",
        "repo": "kh-fab",
        "releaseType": "release"
      }
    ]
  }
}